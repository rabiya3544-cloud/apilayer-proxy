{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/countrylayer", "destination": "/api/countrylayer/all" },
    { "source": "/api/all", "destination": "/api/countrylayer/all" },
    { "source": "/api/countries", "destination": "/api/countrylayer/all" },
    { "source": "/api/countries/:path*", "destination": "/api/countrylayer/:path*" },
    { "source": "/api/search", "destination": "/api/serpstack/search" },
    { "source": "/api/serp", "destination": "/api/serpstack/search" },
    { "source": "/api/locations", "destination": "/api/serpstack/locations" }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 15 }
  }
}
